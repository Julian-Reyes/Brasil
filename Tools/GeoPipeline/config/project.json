  "favela_infill": {
    "_doc": "Procedural informal houses in under-mapped favelas (rio_geo/favela.py), before the ground model. Only adds up to `coverage` of each favela polygon (mapped buildings count); keeps every road/beco/stair/path clear. Frontage houses line every street / beco / stair first, then the interior is filled contour-aligned.",
    "enabled": true,
    "coverage": 0.55,
    "sizes": {
      "_doc": "w = along the street (or contour), d = depth; shares sum to 1. 'wide' = merged / bigger houses.",
      "small": {"share": 0.42, "w": [3.5, 5.0], "d": [4.5, 7.0]},
      "medium": {"share": 0.43, "w": [5.0, 7.0], "d": [5.5, 8.0]},
      "wide": {"share": 0.15, "w": [7.0, 11.0], "d": [6.0, 9.5]}
    },
    "frontage": {
      "_doc": "Houses lining streets, becos and stairs: setback 0 for setback_zero_share of them, else within setback_m; mostly wall to wall (gap_m), sometimes a narrow passage between two houses.",

      "setback_m": [0.2, 1.2],
      "gap_m": [0.2, 0.35],
      "passage_share": 0.12,
      "passage_m": [0.9, 1.6]
    },
    "interior_grid_m": 3.0,
    "min_footprint_m2": 12.0,
    "empty_lot_fraction": 0.06,
    "levels": [2, 4],
    "levels_skew": 1.3,
    "noise_m": 45.0,

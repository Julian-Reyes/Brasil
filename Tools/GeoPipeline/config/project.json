  "water": {
    "_doc": "Inland water (lagoons, lakes, canals) from the OSM reference layer: ground carved to a bed below the surface, flat water meshes per tile (kind Water, M_Sea, no collision). Level = levels_m override, else median DSM inside the polygon (inset dsm_inset_m). The sea is separate (ground_from_dsm).",
    "kinds": ["lagoon", "lake", "reservoir", "pond", "canal", "river", "basin"],
    "exclude": ["fountain", "pool", "wastewater"],
    "min_area_m2": 3000.0,
    "levels_m": {},
    "default_level_m": 0.5,
    "dsm_inset_m": 20.0,
    "shore_depth_m": 0.4,
    "bed_slope": 0.06,
    "max_depth_m": 3.0,
    "connect_m": 60.0,
    "shore_cap": {
      "_doc": "Flat-shore cap (rio_geo.terrain.cap_flat_shores): near lagoons/lakes/canals and large sand beaches the ground may rise at most level + base_m + slope * distance; full within band_m, fading over blend_m. Small beaches are excluded because they sit against rock (Praia do Diabo / Arpoador).",
      "band_m": 35.0,
      "blend_m": 35.0,
      "base_m": 1.0,
      "slope": 0.04,
      "bank_m": 0.6,
      "beach_level_m": 0.5,
      "beach_min_area_m2": 20000.0
    }
  },

